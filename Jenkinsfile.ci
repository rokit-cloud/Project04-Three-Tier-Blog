pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '535066802851'
        EKS_CLUSTER = 'project04-eks'
        ECR_REGISTRY = '535066802851.dkr.ecr.ap-south-1.amazonaws.com'

        FRONTEND_IMAGE = 'blogreact-frontend'
        BACKEND_IMAGE = 'blogreact-backend'

        SONAR_PROJECT_KEY = 'Project04-Three-Tier-Blog'
    }

    stages {
        stage('Checkout and Validate') {
            steps {
                checkout scm
                sh '''
                    set -eu
                    test -f docker-compose.yml
                    test -d frontend
                    test -d backend
                    test -f sonar-project.properties
                    test -f frontend/Dockerfile
                    test -f backend/Dockerfile
                    test -f backend/package.json
                    echo "Project files verified."
                '''
            }
        }

        stage('Check Docker') {
            steps {
                sh '''
                    set -eu
                    docker --version
                    docker info >/dev/null
                    echo "Docker is available."
                '''
            }
        }

        stage('Backend Tests and Coverage') {
            steps {
                sh '''
                    set -eu
                    mkdir -p backend/coverage
                    docker run --rm \
                      -v "$WORKSPACE/backend:/app" \
                      -w /app node:22-alpine \
                      sh -lc 'rm -rf coverage && npm ci && npm test -- --coverage'
                    test -s backend/coverage/lcov.info
                '''
            }
        }

        stage('Frontend Tests and Coverage') {
            steps {
                sh '''
                    set -eu
                    mkdir -p frontend/coverage
                    docker run --rm \
                      -v "$WORKSPACE/frontend:/app" \
                      -w /app node:22-alpine \
                      sh -lc 'rm -rf coverage && npm ci && npm test'
                    test -s frontend/coverage/lcov.info
                '''
            }
        }

        stage('SonarQube Code Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'
                    withSonarQubeEnv('SonarQube') {
                        sh """
                            set -eu
                            test -s backend/coverage/lcov.info
                            test -s frontend/coverage/lcov.info
                            '${scannerHome}/bin/sonar-scanner' \
                              -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                              -Dsonar.projectName=${SONAR_PROJECT_KEY} \
                              -Dsonar.javascript.lcov.reportPaths=backend/coverage/lcov.info,frontend/coverage/lcov.info
                        """
                    }
                }
            }
        }

        stage('Build Frontend Image') {
            steps {
                sh '''
                    set -eu
                    docker build \
                      -t "$FRONTEND_IMAGE:ci" \
                      -t "$FRONTEND_IMAGE:build-$BUILD_NUMBER" \
                      frontend
                '''
            }
        }

        stage('Build Backend Image') {
            steps {
                sh '''
                    set -eu
                    docker build \
                      -t "$BACKEND_IMAGE:ci" \
                      -t "$BACKEND_IMAGE:build-$BUILD_NUMBER" \
                      backend
                '''
            }
        }

        stage('Trivy Frontend Security Scan') {
            steps {
                sh '''
                    set -eu
                    trivy image --severity HIGH,CRITICAL --exit-code 1 \
                      "$FRONTEND_IMAGE:build-$BUILD_NUMBER"
                '''
            }
        }

        stage('Trivy Backend Security Scan') {
            steps {
                sh '''
                    set -eu
                    trivy image --severity HIGH,CRITICAL --exit-code 1 \
                      "$BACKEND_IMAGE:build-$BUILD_NUMBER"
                '''
            }
        }

        stage('ECR Authentication') {
            steps {
                sh '''
                    set -eu
                    aws ecr get-login-password --region "$AWS_REGION" |
                      docker login --username AWS --password-stdin "$ECR_REGISTRY"
                '''
            }
        }

        stage('Push Images to ECR') {
            steps {
                sh '''
                    set -eu

                    for IMAGE in "$FRONTEND_IMAGE" "$BACKEND_IMAGE"; do
                        docker tag "$IMAGE:build-$BUILD_NUMBER" \
                          "$ECR_REGISTRY/$IMAGE:build-$BUILD_NUMBER"
                        docker tag "$IMAGE:ci" \
                          "$ECR_REGISTRY/$IMAGE:ci"

                        docker push "$ECR_REGISTRY/$IMAGE:build-$BUILD_NUMBER"
                        docker push "$ECR_REGISTRY/$IMAGE:ci"
                    done

                    echo "Frontend and backend images pushed to ECR."
                '''
            }
        }

        stage('Deploy to Amazon EKS') {
            steps {
                sh '''
                    set -eu

                    aws eks update-kubeconfig \
                      --region "$AWS_REGION" \
                      --name "$EKS_CLUSTER"

                    kubectl set image deployment/blog-frontend \
                      frontend="$ECR_REGISTRY/$FRONTEND_IMAGE:build-$BUILD_NUMBER" \
                      -n default

                    kubectl set image deployment/blog-backend \
                      backend="$ECR_REGISTRY/$BACKEND_IMAGE:build-$BUILD_NUMBER" \
                      -n default
                '''
            }
        }

        stage('Verify EKS Rollout') {
            steps {
                sh '''
                    set -eu

                    kubectl rollout status deployment/blog-frontend \
                      -n default --timeout=300s

                    kubectl rollout status deployment/blog-backend \
                      -n default --timeout=300s

                    kubectl get deployments -n default
                    kubectl get pods -n default -o wide

                    echo "EKS rollout validation completed."
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: CI, security scans, ECR push and EKS deployment completed.'
        }
        failure {
            echo 'FAILED: Check the first failed stage in Console Output.'
        }
        aborted {
            echo 'Build was aborted before completion.'
        }
        always {
            echo 'Project04 CI/CD pipeline execution finished.'
        }
    }
}
