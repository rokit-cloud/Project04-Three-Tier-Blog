
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        FRONTEND_IMAGE = 'blogreact-frontend:ci'
        BACKEND_IMAGE  = 'blogreact-backend:ci'
        SONAR_PROJECT_KEY = 'Project04-Three-Tier-Blog'
    }

    stages {

        stage('Checkout and Validate') {
            steps {
                checkout scm

                sh '''
                    set -eu

                    echo "Checking project files..."

                    test -f docker-compose.yml
                    test -d frontend
                    test -d backend
                    test -f sonar-project.properties
                    test -f frontend/Dockerfile
                    test -f backend/Dockerfile

                    echo "Project files verified successfully."
                '''
            }
        }

        stage('Check Docker') {
            steps {
                sh '''
                    set -eu

                    docker --version
                    docker info >/dev/null
                    echo "Docker is available."
                '''
            }
        }

        stage('Backend Tests and Coverage') {
            steps {
                sh '''
                    set -eu
                    rm -rf coverage
                    mkdir -p coverage
                    docker build --target test --output type=local,dest=coverage backend
                    test -f coverage/app/coverage/lcov.info
                    mkdir -p backend/coverage
                    cp coverage/app/coverage/lcov.info backend/coverage/lcov.info
                    sed -i 's#^SF:#SF:backend/#' backend/coverage/lcov.info
                    test -s backend/coverage/lcov.info
                    echo "Backend coverage report generated successfully."
                '''
            }
        }

        stage('SonarQube Code Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {
                        sh """
                            set -eu
                            "${scannerHome}/bin/sonar-scanner" \
                              -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                              -Dsonar.projectName=${SONAR_PROJECT_KEY} \
                              -Dsonar.javascript.lcov.reportPaths=backend/coverage/lcov.info
                        """
                    }
                }
            }
        }

        stage('Build Frontend Image') {
            steps {
                sh '''
                    set -eu

                    docker build \
                      --tag "$FRONTEND_IMAGE" \
                      frontend

                    echo "Frontend image built successfully."
                '''
            }
        }

        stage('Build Backend Image') {
            steps {
                sh '''
                    set -eu

                    docker build \
                      --tag "$BACKEND_IMAGE" \
                      backend

                    echo "Backend image built successfully."
                '''
            }
        }

        stage('Trivy Frontend Security Scan') {
            steps {
                sh '''
                    set -eu

                    /usr/local/bin/trivy image \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      "$FRONTEND_IMAGE"

                    echo "Frontend security scan passed."
                '''
            }
        }

        stage('Trivy Backend Security Scan') {
            steps {
                sh '''
                    set -eu

                    /usr/local/bin/trivy image \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      "$BACKEND_IMAGE"

                    echo "Backend security scan passed."
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Validation, SonarQube analysis, Docker builds and Trivy scans completed.'
        }

        failure {
            echo 'FAILURE: Check the first ERROR in Console Output.'
        }

        always {
            echo 'Project04 CI pipeline execution finished.'
        }
    }
}
