pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        FRONTEND_IMAGE = 'blogreact-frontend:ci'
        BACKEND_IMAGE  = 'blogreact-backend:ci'
        SONAR_PROJECT_KEY = 'Project04-Three-Tier-Blog'
    }

    stages {
        stage('Checkout and Validate') {
            steps {
                checkout scm

                sh '''
                    set -eu
                    test -f docker-compose.yml
                    test -d frontend
                    test -d backend
                    test -f sonar-project.properties
                    test -f frontend/Dockerfile
                    test -f backend/Dockerfile
                    test -f backend/package.json
                    echo "Project files verified successfully."
                '''
            }
        }

        stage('Check Docker') {
            steps {
                sh '''
                    set -eu
                    docker --version
                    docker info >/dev/null
                    echo "Docker is available."
                '''
            }
        }

        stage('Backend Tests and Coverage') {
            steps {
                sh '''
                    set -eu
                    echo "Running backend tests and generating coverage..."

                    # Coverage cleanup happens inside Docker as root.
                    mkdir -p backend/coverage

                    docker run --rm \
                        -v "$WORKSPACE/backend:/app" \
                        -w /app \
                        node:22-alpine \
                        sh -lc 'rm -rf coverage && npm ci && npm test -- --coverage'

                    test -s backend/coverage/lcov.info
                    echo "Coverage report generated successfully."
                '''
            }
        }

        stage('Frontend Tests and Coverage') {
            steps {
                sh '''
                    set -eu
                    echo "Running frontend tests and generating coverage..."

                    mkdir -p frontend/coverage

                    docker run --rm \
                        -v "$WORKSPACE/frontend:/app" \
                        -w /app \
                        node:22-alpine \
                        sh -lc 'rm -rf coverage && npm ci && npm test -- --coverage'

                    test -s frontend/coverage/lcov.info
                    echo "Frontend coverage report generated successfully."
                '''
            }
        }

        stage('SonarQube Code Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {
                        sh """
                            set -eu
                            test -s backend/coverage/lcov.info
                            test -s frontend/coverage/lcov.info

                            '${scannerHome}/bin/sonar-scanner' \
                              -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                              -Dsonar.projectName=${SONAR_PROJECT_KEY} \
                              -Dsonar.javascript.lcov.reportPaths=backend/coverage/lcov.info,frontend/coverage/lcov.info
                        """
                    }
                }
            }
        }

        stage('Build Frontend Image') {
            steps {
                sh '''
                    set -eu
                    docker build --tag "$FRONTEND_IMAGE" frontend
                    echo "Frontend image built successfully."
                '''
            }
        }

        stage('Build Backend Image') {
            steps {
                sh '''
                    set -eu
                    docker build --tag "$BACKEND_IMAGE" backend
                    echo "Backend image built successfully."
                '''
            }
        }

        stage('Trivy Frontend Security Scan') {
            steps {
                sh '''
                    set -eu
                    trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        "$FRONTEND_IMAGE"
                    echo "Frontend security scan passed."
                '''
            }
        }

        stage('Trivy Backend Security Scan') {
            steps {
                sh '''
                    set -eu
                    trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        "$BACKEND_IMAGE"
                    echo "Backend security scan passed."
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Tests, coverage, SonarQube analysis, Docker builds and Trivy scans completed.'
        }

        failure {
            echo 'FAILED: Check the first failed stage in Console Output.'
        }

        aborted {
            echo 'Build was aborted before all stages completed.'
        }

        always {
            echo 'Project04 CI pipeline execution finished.'
        }
    }
}
